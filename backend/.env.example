# NFOUZ Backend — Environment Variables Template
# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgres://nfouz:nfouz_pass@localhost:5432/nfouz_db
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep literal \n sequences; env.js converts them to real newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Nearby Players System (Sprint 4)
NEARBY_DEFAULT_RADIUS_METERS=1000
NEARBY_MAX_RADIUS_METERS=5000
NEARBY_MAX_RESULTS=50
NEARBY_ONLINE_THRESHOLD_SECONDS=120

# Photon Multiplayer Foundation (Sprint 5)
BATTLE_MAX_CHALLENGE_DISTANCE_METERS=20
BATTLE_DISCONNECT_GRACE_SECONDS=15
BATTLE_READY_TIMEOUT_SECONDS=30
BATTLE_SESSION_MAX_DURATION_SECONDS=90

# Full Combat System (Sprint 6) — approved GDD v1.0 §7/§8 values
INFLUENCE_WIN_DELTA=15
INFLUENCE_LOSS_DELTA=-10
CONTROL_DURATION_MINUTES=120

# Sprint 6 final security correction — signed authoritative battle result
# (Host Mode Alpha: limited anti-cheat, not full server authority — see
# battle.service.js resolveBattle's doc comment)
COMBAT_RULES_VERSION=6.1.0
RESULT_MAX_AGE_SECONDS=120
RESULT_MAX_CLOCK_SKEW_SECONDS=15
RESULT_MAX_DURATION_SECONDS=130
RESULT_MAX_PLAUSIBLE_HEALTH=500

# Sprint 6 final gameplay-completion pass — Alpha security mode
# (provisional tier: pending_review, no Influence/Control until reviewed)
RESULT_SUSPICIOUS_MIN_DURATION_SECONDS=2
RESULT_SUSPICIOUS_DURATION_SECONDS=125
RESULT_SUSPICIOUS_HEALTH_THRESHOLD=160
